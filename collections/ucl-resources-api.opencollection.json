{
  "opencollection": "1.0.0",
  "info": {
    "name": "UCL Analytics Resources API",
    "version": "1.0.0-oas3"
  },
  "items": [
    {
      "info": {
        "name": "Resources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Returns number of desktops and how many are free at the time of making the request.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://uclapi.com/resources/desktops",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "/authorise",
              "accessTokenUrl": "/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns number of desktops and how many are free at the time of making the request."
        }
      ]
    }
  ],
  "bundled": true
}