          },
          "http": {
            "method": "GET",
            "url": "https://uclapi.com/dashboard/api/analytics/methods",
            "params": [
              {
                "name": "service",
                "value": "",
                "type": "query",
                "description": "The service to check the popularity of methods for"
              }
            ]
          },
          "docs": "Gets all methods for a given service and their popularity"
        },
        {
          "info": {
            "name": "Gets the total number of users for a given app token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://uclapi.com/dashboard/api/analytics/oauth/total",
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date to filter by"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date to filter by"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "/authorise",
              "accessTokenUrl": "/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Gets the total number of users for a given app token"
        },
