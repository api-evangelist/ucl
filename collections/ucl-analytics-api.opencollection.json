{
  "opencollection": "1.0.0",
  "info": {
    "name": "UCL Analytics API",
    "version": "1.0.0-oas3"
  },
  "items": [
    {
      "info": {
        "name": "Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Gets the total number of requests made from a given token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://uclapi.com/dashboard/api/analytics/total",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "/authorise",
              "accessTokenUrl": "/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Gets the total number of requests made from a given token"
        },
        {
          "info": {
            "name": "Gets the remaining daily quota for a given token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://uclapi.com/dashboard/api/analytics/quota",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "/authorise",
              "accessTokenUrl": "/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Gets the remaining daily quota for a given token"
        },
        {
          "info": {
            "name": "Gets all services and their popularity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://uclapi.com/dashboard/api/analytics/services"
          },
          "docs": "Gets all services and their popularity"
        },
        {
          "info": {
            "name": "Gets all methods for a given service and their popularity",
